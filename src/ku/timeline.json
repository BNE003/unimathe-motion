  "subtitles": [
    [
      0.0,
      3.9,
      "Typische Klausuraufgabe: Ist U ein Untervektorraum?"
    ],
    [
      5.42,
      7.3,
      "Ich zeig dir die Lösung in drei Schritten."
    ],
    [
      9.1,
      10.18,
      "Was bedeutet U?"
    ],
    [
      11.34,
      15.26,
      "Alle Punkte, bei denen x + y genau 2z ergibt."
    ],
    [
      16.4,
      18.58,
      "Zum Beispiel (1, 1, 1):"
    ],
    [
      19.06,
      21.94,
      "1 + 1 = 2 · 1. Passt."
    ],
    [
      23.18,
      25.9,
      "Alle passenden Punkte bilden zusammen eine Ebene."
    ],
    [
      27.28,
      29.9,
      "Für einen Untervektorraum prüfst du drei Bedingungen:"
    ],
    [
      30.84,
      33.5,
      "Nullvektor, Summe, Vielfaches."
    ],
    [
      34.6,
      36.26,
      "Erstens: der Nullvektor."
    ],
    [
      37.34,
      41.44,
      "Setz ihn ein: 0 + 0 ist 0, 2 · 0 auch."
    ],
    [
      42.26,
      44.48,
      "Passt. Der Nullvektor liegt in U."
    ],
    [
      45.62,
      48.84,
      "Zweitens: die Summe. Das ist der wichtigste Schritt."
    ],
    [
      49.9,
      53.06,
      "Nimm zwei beliebige Vektoren u und v aus U."
    ],
    [
      53.56,
      54.86,
      "Für beide gilt die Gleichung."
    ],
    [
      55.8,
      58.6,
      "Zu zeigen: Sie gilt auch für u + v."
    ],
    [
      59.68,
      63.16,
      "Sortier links um: alles von u, dann alles von v."
    ],
    [
      64.12,
      65.64,
      "Jetzt die Gleichungen einsetzen."
    ],
    [
      66.58,
      67.48,
      "Zwei ausklammern."
    ],
    [
      67.94,
      69.82,
      "Fertig: genau die rechte Seite."
    ],
    [
      70.84,
      73.64,
      "Drittens: das Vielfache. Gleiches Muster."
    ],
    [
      74.54,
      77.44,
      "Zu zeigen: Die Gleichung gilt für λ · u."
    ],
    [
      78.3,
      81.04,
      "λ ausklammern, einsetzen, umstellen."
    ],
    [
      81.8,
      83.4,
      "Wieder genau die rechte Seite."
    ],
    [
      84.26,
      85.78,
      "Alle drei Bedingungen erfüllt."
    ],
    [
      86.42,
      88.16,
      "U ist ein Untervektorraum."
    ],
    [
      89.24,
      93.12,
